<odoo noupdate="1">
    <!-- Triggered immediately when a question is queued; the interval is only
         a fallback for requests left behind, e.g. after a restart. -->
    <record id="ir_cron_ai_discuss_bot_process" model="ir.cron">
        <field name="name">AI Discuss Bot: answer questions</field>
        <field name="model_id" ref="model_ai_discuss_bot_request" />
        <field name="state">code</field>
        <field name="code">model._cron_process_requests()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
    </record>
</odoo>
